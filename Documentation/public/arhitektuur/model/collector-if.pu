@startuml

left to right direction

[Collector Service] as collector


package "Environment Services" {
    [Registration Service] as tsa
    [Authentication Service] as auth
    [Signing Service] as sign
}

[Lists] as voterlist
[Backup] as backup


actor Owner as owner
actor Processor as offline

actor Helpdesk as helpdesk

actor Voter as voter

actor :Collector Service admin: as admin
actor :Collector Service remote admin: as radmin


interface "Election definition" as i_define
interface "Ballot export" as i_export
interface "Voting" as i_vote
interface "Verification" as i_verify
interface "Choice list" as i_cls
interface "Command line" as i_localadmin
interface "Remote management" as i_remoteadmin
interface "Monitoring" as i_monitor
interface "Helpdesk" as i_helpdesk

interface "Backup" as i_backup
interface "List updates" as i_voterlist

collector -down- i_cls
collector -down- i_vote
collector -down- i_verify
voter -up-> i_vote
voter -up-> i_verify
voter -up-> i_cls


collector -up- i_localadmin
collector -up- i_helpdesk
collector -up- i_monitor
collector -up- i_remoteadmin

admin -down-> i_localadmin
helpdesk -down-> i_helpdesk
radmin -down-> i_monitor
radmin -left-> i_remoteadmin


collector -right- i_define
collector -right- i_export
owner -left-> i_define
offline -left-> i_export
owner -up-> i_remoteadmin


voterlist -right- i_voterlist
backup -right- i_backup


collector .left.> i_backup
collector .left.> i_voterlist

@enduml
